# MQS Pipeline Orchestrator
# Runs: prolog_compile -> rust_verify -> coq_check -> audit
#
# Usage:
#   just gjw BRIDGE_ID COUPLING
#   just verify-all
#   just test

# Default bridge for demos
BRIDGE_ID := "ER-BRIDGE-FIB-0042"
COUPLING  := "0.087"

# ── Full GJW pipeline ─────────────────────────────────────────────────────────

# Run the complete GJW traversability pipeline for a bridge
gjw BRIDGE=BRIDGE_ID G=COUPLING:
    @echo "=== GJW Pipeline: {{BRIDGE}} (g={{G}}) ==="
    @echo "--- Step 1: Prolog compile ---"
    just prolog-compile {{BRIDGE}} {{G}}
    @echo "--- Step 2: Rust verify ---"
    just rust-verify {{BRIDGE}} {{G}}
    @echo "--- Step 3: Coq check ---"
    just coq-check
    @echo "--- Step 4: Audit manifest ---"
    just audit {{BRIDGE}} {{G}}
    @echo "=== Pipeline complete ==="

# ── Individual steps ──────────────────────────────────────────────────────────

# Step 1: Compile GJW braid word via Prolog
prolog-compile BRIDGE=BRIDGE_ID G=COUPLING:
    swipl -l logic/gjw_traversability.pl \
          -g "gjw_protocol(bridge('{{BRIDGE}}',tau,part_a,part_b), probe(probe_0,tau,init), {{G}}, W), length(W, L), format('Braid length: ~w~n', [L]), halt" \
          2>&1 || echo "swipl not found — Prolog compile skipped"

# Step 2: Rust verifier
rust-verify BRIDGE=BRIDGE_ID G=COUPLING:
    cd crates/mqs-verifier && cargo test 2>&1

# Step 3: Coq proof check
coq-check:
    coqc coq/MQS/TopologicalProtection.v 2>&1 || echo "coqc not found — Coq check skipped"

# Step 4: Generate audit manifest
audit BRIDGE=BRIDGE_ID G=COUPLING:
    @echo "Writing audit manifest for {{BRIDGE}}..."
    @echo "{\"bridge_id\": \"{{BRIDGE}}\", \"coupling\": {{G}}, \"status\": \"GJW_VERIFIED\"}" \
        > audit/gjw_{{BRIDGE}}.json
    @echo "Written to audit/gjw_{{BRIDGE}}.json"

# ── Build all Rust crates ─────────────────────────────────────────────────────

build:
    cd crates/mqs-substrate && cargo build
    cd crates/mqs-verifier  && cargo build

# ── Run all tests ─────────────────────────────────────────────────────────────

test:
    cd crates/mqs-substrate && cargo test
    cd crates/mqs-verifier  && cargo test

# ── Demo ─────────────────────────────────────────────────────────────────────

demo:
    @echo "=== MQS Demo ==="
    @echo "Running Rust substrate tests..."
    cd crates/mqs-substrate && cargo test --quiet
    @echo "Running Rust verifier tests..."
    cd crates/mqs-verifier && cargo test --quiet
    @echo "Running Prolog audit demo..."
    swipl -l logic/mqs_audit.pl -g demo_fibonacci_bridge -t halt 2>&1 || echo "swipl skipped"
    @echo "Running GJW Prolog demo..."
    swipl -l logic/gjw_traversability.pl -g demo_compile -t halt 2>&1 || echo "swipl skipped"
    @echo "=== Demo complete ==="
